msgid "Bomba de queroseno"
msgstr "Kerosene bomb"

#: data/weapons/bomba_queroseno.tres
msgid "Revienta al caer y deja un fuego más breve."
msgstr "It bursts on landing and leaves a shorter fire."

#: data/weapons/botica_arkham.tres
msgid "Botica de Arkham"
msgstr "Arkham apothecary"

#: data/weapons/botica_arkham.tres
msgid "Dos frascos por disparo; charcos más grandes que dejan vulnerables más tiempo."
msgstr "Two flasks per throw; bigger puddles that leave enemies vulnerable for longer."

#: data/weapons/bumeran.tres
msgid "Bumerán"
msgstr "Boomerang"

#: data/weapons/bumeran.tres
msgid "Va hasta su alcance y vuelve a tus manos, golpeando a la ida y a la vuelta."
msgstr "It flies out to its range and comes back to your hands, hitting on the way out and on the way back."

#: data/weapons/bumeran_guerra.tres
msgid "Bumerán de guerra"
msgstr "War boomerang"

#: data/weapons/bumeran_guerra.tres
msgid "Un solo bumerán enorme y más lento que arrolla y empuja a todo lo que cruza."
msgstr "A single huge, slower boomerang that ploughs through and pushes everything it crosses."

#: data/weapons/bumeran_hueso.tres
msgid "Bumerán de hueso"
msgstr "Bone boomerang"

#: data/weapons/bumeran_hueso.tres
msgid "Tres bumeranes de hueso tallado que van más lejos y más deprisa."
msgstr "Three carved bone boomerangs that fly further and faster."

#: data/weapons/cabeza_dragon.tres
msgid "Cabeza del Dragón"
msgstr "Dragon's Head"

#: data/weapons/cabeza_dragon.tres
msgid "Y'ai 'ng'ngah, Yog-Sothoth: levanta a cuatro a la vez en un círculo más ancho, y duran más."
msgstr "Y'ai 'ng'ngah, Yog-Sothoth: raises four at once in a wider circle, and they last longer."

#: data/weapons/cabra_negra.tres
msgid "La Cabra Negra"
msgstr "The Black Goat"

#: data/weapons/cabra_negra.tres
msgid "Menos tentáculos, enormes, que aturden el doble."
msgstr "Fewer tentacles, but huge, and they stun twice as long."

#: data/weapons/canon_antitanque.tres
msgid "Cañón antitanque"
msgstr "Anti-tank gun"

#: data/weapons/canon_antitanque.tres
msgid "Un disparo aún más pesado que derriba a los grandes."
msgstr "An even heavier shot that knocks down the big ones."

#: data/weapons/carabina_mauser.tres
msgid "Carabina Mauser"
msgstr "Mauser carbine"

#: data/weapons/carabina_mauser.tres
msgid "Con la culata puesta: un solo disparo que llega lejos y atraviesa a cinco."
msgstr "With the stock fitted: a single shot that reaches far and pierces five."

#: data/weapons/carcosa.tres
msgid "Carcosa"
msgstr "Carcosa"

#: data/weapons/carcosa.tres
msgid "Enloquece desde mucho más lejos y más a menudo."
msgstr "Drives enemies mad from much further away, and more often."

#: data/weapons/carga_concentrada.tres
msgid "Carga concentrada"
msgstr "Bundled charge"

#: data/weapons/carga_concentrada.tres
msgid "Tres granadas atadas a un mango: una explosión enorme que derriba a los que no mata."
msgstr "Three grenades tied to one handle: a huge explosion that knocks down whatever it doesn't kill."

#: data/weapons/castillo_fuegos.tres
msgid "Gran castillo de fuegos"
msgstr "Grand fireworks display"

#: data/weapons/castillo_fuegos.tres
msgid "Tres cohetes por disparo que se abren en el doble de chispas."
msgstr "Three rockets per shot that burst into twice as many sparks."

#: data/weapons/cepo_oso.tres
msgid "Cepo de oso"
msgstr "Bear trap"

#: data/weapons/cepo_oso.tres
msgid "Un solo cepo enorme que atrapa a todos los de alrededor."
msgstr "A single huge trap that catches everyone around it."

#: data/weapons/cepos.tres
msgid "Cepos"
msgstr "Traps"

#: data/weapons/cepos.tres
msgid "Deja cepos en el suelo: el primero que los pisa queda atrapado y herido."
msgstr "Leaves traps on the ground: the first one to step on them is caught and wounded."

#: data/weapons/cepos_cazador.tres
msgid "Cepos del cazador"
msgstr "Hunter's traps"

#: data/weapons/cepos_cazador.tres
msgid "El doble de cepos que atrapan más tiempo."
msgstr "Twice as many traps, holding for longer."

#: data/weapons/chispas_fomalhaut.tres
msgid "Bolas de fuego rápidas, el doble de seguidas, con un rastro más corto."
msgstr "Fast fireballs, twice as often, with a shorter trail."

#: data/weapons/chispas_fomalhaut.tres
msgid "Chispas de Fomalhaut"
msgstr "Sparks of Fomalhaut"

#: data/weapons/cilindro_migo.tres
msgid "Cilindro de los Mi-Go"
msgstr "Mi-Go cylinder"

#: data/weapons/cilindro_migo.tres
msgid "Orbes que disparan el doble de rápido en una órbita más amplia."
msgstr "Orbs that fire twice as fast in a wider orbit."

#: data/weapons/coctel_emma.tres
msgid "Cóctel del Emma"
msgstr "The Emma's cocktail"

#: data/weapons/coctel_emma.tres
msgid "Dos botellas que dejan charcos de fuego más grandes y duraderos."
msgstr "Two bottles that leave bigger, longer-lasting pools of fire."

#: data/weapons/cohete_feria.tres
msgid "Cohete de la feria"
msgstr "Fairground rocket"

#: data/weapons/cohete_feria.tres
msgid "Un solo cohete grande que atraviesa a cuatro y estalla en una lluvia de chispas."
msgstr "A single big rocket that pierces four and bursts into a shower of sparks."

#: data/weapons/cola_dragon.tres
msgid "Cola del Dragón"
msgstr "Dragon's Tail"

#: data/weapons/cola_dragon.tres
msgid "Ogthrod ai'f geb'l-ee'h: los levantados vuelven a ser polvo de golpe y revientan al deshacerse."
msgstr "Ogthrod ai'f geb'l-ee'h: the raised turn back to dust at once and burst as they crumble."

#: data/weapons/corredera.tres
msgid "Escopeta de corredera"
msgstr "Pump-action shotgun"

#: data/weapons/corredera.tres
msgid "Perdigones que se abren en anillo alrededor del personaje."
msgstr "Pellets that spread in a ring around the character."

#: data/weapons/cthugha.tres
msgid "Bola de fuego vivo que atraviesa a los enemigos y deja un rastro ardiendo."
msgstr "A ball of living fire that pierces enemies and leaves a burning trail."

#: data/weapons/cthugha.tres
msgid "Llama de Cthugha"
msgstr "Flame of Cthugha"

#: data/weapons/daga.tres
msgid "Apuñala al enemigo más cercano y lo maldice: pierde vida poco a poco y, si muere maldito, la maldición salta a los de al lado. Cuesta cordura."
msgstr "Stabs the nearest enemy and curses it: it slowly loses health and, if it dies cursed, the curse jumps to those beside it. Costs sanity."

#: data/weapons/daga.tres
msgid "Daga ritual"
msgstr "Ritual dagger"

#: data/weapons/daga_obsidiana.tres
msgid "Daga de obsidiana"
msgstr "Obsidian dagger"

#: data/weapons/daga_obsidiana.tres
msgid "Puñaladas el doble de seguidas y desde más lejos; la maldición, breve y sin saltar."
msgstr "Stabs twice as often and from further away; the curse is brief and doesn't jump."

#: data/weapons/daga_sacrificio.tres
msgid "Daga del sacrificio"
msgstr "Sacrificial dagger"

#: data/weapons/daga_sacrificio.tres
msgid "La maldición dura más, quema más y salta a cuatro enemigos al morir el maldito."
msgstr "The curse lasts longer, burns more and jumps to four enemies when the cursed one dies."

#: data/weapons/el_umbral.tres
msgid "Depende de quién esté en el cuerpo. Edward da un golpe alrededor, de cerca y fuerte (físico); Asenath lanza dos miradas verdes que buscan al enemigo (mágicas, cuestan cordura). Cada esquive los cambia."
msgstr "It depends on who is in the body. Edward strikes all around, close and hard (physical); Asenath casts two green glares that seek out the enemy (magic, they cost sanity). Each dodge swaps them."

#: data/weapons/el_umbral.tres
msgid "El umbral"
msgstr "The threshold"

#: data/weapons/enjambre_yuggoth.tres
msgid "Cuatro orbes más que vuelan alrededor más tiempo."
msgstr "Four more orbs that fly around for longer."

#: data/weapons/enjambre_yuggoth.tres
msgid "Enjambre de Yuggoth"
msgstr "Swarm of Yuggoth"

#: data/weapons/ensueno_celephais.tres
msgid "Ensueño de Celephaïs"
msgstr "Reverie of Celephaïs"

#: data/weapons/ensueno_celephais.tres
msgid "Un trozo del cielo de Celephaïs donde más enemigos hay: dentro sueñan y van cada vez más despacio, sus balas se frenan y los investigadores recuperan cordura."
msgstr "A piece of the sky of Celephaïs where the enemies are thickest: inside, they dream and move ever more slowly, their bullets slow down and the investigators recover sanity."

#: data/weapons/escopeta_postas.tres
msgid "Cinco postas en un cono cerrado que llegan el doble de lejos y atraviesan."
msgstr "Five buckshot pellets in a tight cone that reach twice as far and pierce."

#: data/weapons/escopeta_postas.tres
msgid "Escopeta de postas"
msgstr "Buckshot shotgun"

#: data/weapons/escopeta_trinchera.tres
msgid "Escopeta de trinchera"
msgstr "Trench shotgun"

#: data/weapons/escopeta_trinchera.tres
msgid "Un anillo de perdigones el doble de denso que barre todo alrededor y empuja más."
msgstr "A ring of pellets twice as dense that sweeps all around and pushes harder."

#: data/weapons/estoque.tres
msgid "Bastón estoque"
msgstr "Sword cane"

#: data/weapons/estoque.tres
msgid "Estocada larga y rápida hacia el enemigo más cercano que atraviesa todo lo que hay en la línea. Espera a tener a alguien a su alcance."
msgstr "A long, quick thrust at the nearest enemy that pierces everything in the line. It waits until someone is within reach."

#: data/weapons/estoque_duelista.tres
msgid "Estocada más larga y más fina que atraviesa toda la línea dos veces más rápido."
msgstr "A longer, finer thrust that pierces the whole line twice as fast."

#: data/weapons/estoque_duelista.tres
msgid "Estoque del duelista"
msgstr "Duellist's rapier"

#: data/weapons/exorcismo_mayor.tres
msgid "Exorcismo mayor"
msgstr "Greater exorcism"

#: data/weapons/exorcismo_mayor.tres
msgid "Una onda mayor que empuja más lejos y aturde el doble."
msgstr "A bigger wave that pushes further and stuns twice as long."

#: data/weapons/faro_irem.tres
msgid "Faro de Irem"
msgstr "Beacon of Irem"

#: data/weapons/faro_irem.tres
msgid "Un haz mucho más largo que gira despacio y dura más."
msgstr "A much longer beam that turns slowly and lasts longer."

#: data/weapons/farolero.tres
msgid "Báculo del Farolero"
msgstr "Lamplighter's staff"

#: data/weapons/farolero.tres
msgid "Suelta fuegos fatuos que zigzaguean y buscan solos a los enemigos. Cuesta cordura."
msgstr "Releases will-o'-the-wisps that zigzag and seek out enemies on their own. Costs sanity."

#: data/weapons/flammenwerfer.tres
msgid "Chorro de fuego en cono que deja el suelo ardiendo."
msgstr "A cone of fire that leaves the ground burning."

#: data/weapons/flammenwerfer.tres
msgid "Flammenwerfer"
msgstr "Flammenwerfer"

#: data/weapons/formula.tres
msgid "Fórmula de expulsión"
msgstr "Banishing formula"

#: data/weapons/formula.tres
msgid "Onda que se expande desde el personaje, empuja y aturde. Cuesta cordura."
msgstr "A wave that spreads out from the character, pushing and stunning. Costs sanity."

#: data/weapons/fosgeno.tres
msgid "Fosgeno"
msgstr "Phosgene"

#: data/weapons/fosgeno.tres
msgid "Una nube quieta que deja vulnerables a los que la cruzan."
msgstr "A still cloud that leaves anyone crossing it vulnerable."

#: data/weapons/fuego_santelmo.tres
msgid "Fuego de San Telmo"
msgstr "St Elmo's fire"

#: data/weapons/fuego_santelmo.tres
msgid "Un fuego fatuo enorme que atraviesa a tres y, al apagarse, se parte en seis."
msgstr "A huge will-o'-the-wisp that pierces three and, as it dies out, splits into six."

#: data/weapons/fuegos.tres
msgid "Cohetes erráticos que estallan en chispas."
msgstr "Erratic rockets that burst into sparks."

#: data/weapons/fuegos.tres
msgid "Fuegos artificiales"
msgstr "Fireworks"

#: data/weapons/fusil_cazacarros.tres
msgid "Dispara el doble de seguido, con algo menos de empuje."
msgstr "Fires twice as often, with a little less knockback."

#: data/weapons/fusil_cazacarros.tres
msgid "Fusil del cazacarros"
msgstr "Tank hunter's rifle"

#: data/weapons/galeria_pickman.tres
msgid "Galería de North End"
msgstr "North End gallery"

#: data/weapons/galeria_pickman.tres
msgid "Tres lienzos a la vez, que atraen desde más lejos y sueltan necrófagos que cazan más tiempo."
msgstr "Three canvases at once, which lure from further away and release ghouls that hunt for longer."

#: data/weapons/gas.tres
msgid "Gas de cloro"
msgstr "Chlorine gas"

#: data/weapons/gas.tres
msgid "Nube tóxica que deriva lentamente hacia los enemigos y los envenena."
msgstr "A toxic cloud that drifts slowly towards the enemies and poisons them."

#: data/weapons/gas_mostaza.tres
msgid "Gas mostaza"
msgstr "Mustard gas"

#: data/weapons/gas_mostaza.tres
msgid "Una nube mayor y más duradera que avanza más deprisa."
msgstr "A bigger, longer-lasting cloud that moves faster."

#: data/weapons/geometria_bruja.tres
msgid "Cinco ángulos a la vez, que doblan antes y atraviesan a dos más."
msgstr "Five angles at once, which turn sooner and pierce two more."

#: data/weapons/geometria_bruja.tres
msgid "La geometría de la bruja"
msgstr "The witch's geometry"

#: data/weapons/gran_resonador.tres
msgid "Gran resonador"
msgstr "Great resonator"

#: data/weapons/gran_resonador.tres
msgid "Una onda mayor que deshace las balas más lejos y más a menudo."
msgstr "A bigger wave that dissolves bullets further away and more often."

#: data/weapons/granada.tres
msgid "Granada de palo lanzada a la zona más densa; gran explosión al impactar."
msgstr "A stick grenade thrown at the densest area; a big explosion on impact."

#: data/weapons/granada.tres
msgid "Stielhandgranate"
msgstr "Stielhandgranate"

#: data/weapons/huellas_dunwich.tres
msgid "El hermano de Wilbur, que nadie ve, avanza en línea recta hacia el grupo más denso: aplasta y aturde lo que pisa."
msgstr "Wilbur's brother, whom no one can see, advances in a straight line towards the densest group: it crushes and stuns whatever it treads on."

#: data/weapons/huellas_dunwich.tres
msgid "Pisadas de lo invisible"
msgstr "Footsteps of the unseen"

#: data/weapons/huellas_gemelo.tres
msgid "El gemelo de Wilbur"
msgstr "Wilbur's twin"

#: data/weapons/huellas_gemelo.tres
msgid "Tres hileras de pisadas a la vez, más largas."
msgstr "Three rows of footsteps at once, longer."

#: data/weapons/huellas_sentinel.tres
msgid "Lo que bajó de Sentinel Hill"
msgstr "What came down from Sentinel Hill"

#: data/weapons/huellas_sentinel.tres
msgid "Pisadas el doble de anchas que aplastan más y aturden más tiempo."
msgstr "Footsteps twice as wide that crush harder and stun for longer."

#: data/weapons/instrumental.tres
msgid "Abanico ancho de ocho hojas que atraviesan a tres enemigos."
msgstr "A wide fan of eight blades that pierce three enemies."

#: data/weapons/instrumental.tres
msgid "Instrumental"
msgstr "Surgical kit"

#: data/weapons/ithaqua.tres
msgid "Aliento de Ithaqua"
msgstr "Breath of Ithaqua"

#: data/weapons/ithaqua.tres
msgid "Viento helado en cono que frena a los enemigos y congela a los que siguen dentro."
msgstr "A cone of icy wind that slows enemies and freezes those who stay inside."

#: data/weapons/lampara.tres
msgid "Haz de luz que barre en círculo alrededor del personaje."
msgstr "A beam of light that sweeps in a circle around the character."

#: data/weapons/lampara.tres
msgid "Lámpara de Alhazred"
msgstr "Lamp of Alhazred"

#: data/weapons/lampara_alhazred.tres
msgid "Dos haces de luz que giran más deprisa y más lejos."
msgstr "Two beams of light that turn faster and reach further."

#: data/weapons/lampara_alhazred.tres
msgid "Lámpara del Árabe Loco"
msgstr "Lamp of the Mad Arab"

#: data/weapons/lanza_bomba.tres
msgid "Lanza bomba"
msgstr "Bomb lance"

#: data/weapons/lanza_bomba.tres
msgid "Un arpón con carga en la punta: al clavarse revienta en metralla y frena a los que alcanza."
msgstr "A harpoon with a charge in its tip: when it strikes, it bursts into shrapnel and slows those it hits."

#: data/weapons/lanza_termica.tres
msgid "Lanza térmica"
msgstr "Thermal lance"

#: data/weapons/lanza_termica.tres
msgid "Un chorro estrecho y larguísimo que se recarga antes; deja menos fuego en el suelo."
msgstr "A narrow, very long jet that recharges sooner; it leaves less fire on the ground."

#: data/weapons/lanzaquimicos.tres
msgid "Frasco de ácido: los enemigos del charco reciben un 25 % más de daño."
msgstr "Acid flask: enemies in the puddle take 25 % more damage."

#: data/weapons/lanzaquimicos.tres
msgid "Lanzaquímicos"
msgstr "Chemical thrower"

#: data/weapons/latigo.tres
msgid "Latigazo largo en arco por delante que golpea a todos los del arco."
msgstr "A long lash in an arc ahead that hits everyone in the arc."

#: data/weapons/latigo.tres
msgid "Látigo"
msgstr "Whip"

#: data/weapons/latigo_domador.tres
msgid "Látigo del domador"
msgstr "Tamer's whip"

#: data/weapons/latigo_domador.tres
msgid "Un latigazo más largo que barre todo alrededor."
msgstr "A longer lash that sweeps all around."

#: data/weapons/latigo_mayoral.tres
msgid "Látigo del mayoral"
msgstr "Overseer's whip"

#: data/weapons/latigo_mayoral.tres
msgid "Un chasquido estrecho que llega casi el doble de lejos, más seguido."
msgstr "A narrow crack that reaches almost twice as far, more often."

#: data/weapons/lente.tres
msgid "Lente del Éter"
msgstr "Aether lens"

#: data/weapons/lente.tres
msgid "Rayo sostenido sobre un enemigo: su daño crece mientras sigue sobre él, hasta el triple. Si el enemigo cae, salta a otro. Cuesta cordura."
msgstr "A beam held on one enemy: its damage grows while it stays on it, up to three times. If the enemy falls, it jumps to another. Costs sanity."

#: data/weapons/letania.tres
msgid "Letanía de expulsión"
msgstr "Banishing litany"

#: data/weapons/letania.tres
msgid "Una onda algo menor, más del doble de seguida y a mitad de cordura."
msgstr "A slightly smaller wave, more than twice as often and at half the sanity cost."

#: data/weapons/lewis.tres
msgid "Ametralladora Lewis"
msgstr "Lewis gun"

#: data/weapons/lewis.tres
msgid "Monta la ametralladora en su trípode, en el suelo; dispara sola al más cercano durante 8 segundos."
msgstr "Sets the machine gun on its tripod on the ground; it fires on its own at the nearest enemy for 8 seconds."

#: data/weapons/lienzos.tres
msgid "Lienzos de Pickman"
msgstr "Pickman's canvases"

#: data/weapons/lienzos.tres
msgid "Planta un cuadro entre los enemigos que los atrae y los deja vulnerables. Cuando lo rompen, revienta y sale de él un necrófago que caza un rato."
msgstr "Plants a painting among the enemies that lures them and leaves them vulnerable. When they break it, it bursts and a ghoul comes out of it to hunt for a while."

#: data/weapons/linterna_fatuos.tres
msgid "El doble de fuegos fatuos, que buscan a sus presas con más ganas."
msgstr "Twice as many will-o'-the-wisps, hunting their prey more eagerly."

#: data/weapons/linterna_fatuos.tres
msgid "Linterna de los fatuos"
msgstr "Will-o'-the-wisp lantern"

#: data/weapons/llama_culto.tres
msgid "Llama del culto"
msgstr "Flame of the cult"

#: data/weapons/llama_culto.tres
msgid "Una bola de fuego mayor con un rastro que arde mucho más."
msgstr "A bigger fireball with a trail that burns much more."

#: data/weapons/llave_kadath.tres
msgid "Cuatro llaves que adormecen el doble y llegan más lejos."
msgstr "Four keys that lull twice as long and reach further."

#: data/weapons/llave_kadath.tres
msgid "Llave de la ignota Kadath"
msgstr "Key of unknown Kadath"

#: data/weapons/llave_suenos.tres
msgid "La llave de plata de Randolph Carter va hasta su alcance y vuelve, y deja adormilado un momento a todo lo que toca."
msgstr "Randolph Carter's silver key flies out to its range and back, leaving everything it touches drowsy for a moment."

#: data/weapons/llave_suenos.tres
msgid "Llave de los sueños"
msgstr "Key of dreams"

#: data/weapons/llave_ulthar.tres
msgid "Llaves de Ulthar"
msgstr "Keys of Ulthar"

#: data/weapons/llave_ulthar.tres
msgid "Seis llaves más rápidas, en abanico, que adormecen menos."
msgstr "Six faster keys in a fan, which lull for less time."

#: data/weapons/lo_que_llamo.tres
msgid "Cada cambio de cuerpo suelta una onda verde podrida que daña y aparta a los de alrededor; el golpe de Edward, más amplio."
msgstr "Each change of body releases a rotten green wave that damages and pushes away those around; Edward's blow is wider."

#: data/weapons/lo_que_llamo.tres
msgid "Lo que llamó a la puerta"
msgstr "The thing on the doorstep"

#: data/weapons/lo_que_nos_rodea.tres
msgid "Lo que nos rodea"
msgstr "What surrounds us"

#: data/weapons/lo_que_nos_rodea.tres
msgid "Una onda mucho más amplia: revela más tiempo y lo revelado recibe aún más daño."
msgstr "A much wider wave: it reveals for longer and what is revealed takes even more damage."

#: data/weapons/lugers.tres
msgid "Lugers a dos manos"
msgstr "Twin Lugers"

#: data/weapons/lugers.tres
msgid "Una pistola en cada mano: disparan a la vez hacia donde andas y hacia atrás, sin buscar objetivo."
msgstr "A pistol in each hand: they fire at once where you are heading and behind you, without seeking a target."

#: data/weapons/lugers_as.tres
msgid "Lugers del as"
msgstr "The ace's Lugers"

#: data/weapons/lugers_as.tres
msgid "Tres balas por cañón, delante y detrás, más deprisa."
msgstr "Three bullets per barrel, forwards and backwards, faster."

#: data/weapons/lugers_feria.tres
msgid "Cada bala rebota en otros dos enemigos."
msgstr "Each bullet bounces off two more enemies."

#: data/weapons/lugers_feria.tres
msgid "Lugers de feria"
msgstr "Trick-shot Lugers"

#: data/weapons/machete.tres
msgid "Machete"
msgstr "Machete"

#: data/weapons/machete.tres
msgid "Tajo circular alrededor del personaje; solo golpea si hay alguien cerca."
msgstr "A circular slash around the character; it only strikes if someone is close."

#: data/weapons/machete_canaveral.tres
msgid "Machete del cañaveral"
msgstr "Canefield machete"

#: data/weapons/machete_canaveral.tres
msgid "Un tajo mucho más amplio que empuja más y golpea más a menudo."
msgstr "A much wider slash that pushes harder and strikes more often."

#: data/weapons/machetes_zafra.tres
msgid "Machetes de zafra"
msgstr "Harvest machetes"

#: data/weapons/machetes_zafra.tres
msgid "Tajos el doble de seguidos, que apenas empujan: no dejan respirar."
msgstr "Slashes twice as often that barely push: they give no breathing room."

#: data/weapons/maquina_mas_alla.tres
msgid "Máquina del más allá"
msgstr "Machine from beyond"

#: data/weapons/maquina_mas_alla.tres
msgid "Una onda violeta que revela lo que nos rodea: los alcanzados reciben un 30 % más de daño de todo durante unos segundos, y los ocultos salen. Cada pulso seguido calienta la máquina y quita más cordura a todo el grupo cercano."
msgstr "A violet wave that reveals what surrounds us: those it reaches take 30 % more damage from everything for a few seconds, and the hidden come out. Each pulse in a row heats up the machine and takes more sanity from the whole group nearby."

#: data/weapons/martillo.tres
msgid "Golpea el suelo y abre una grieta que avanza en línea recta, daña y aturde un momento a todo lo que encuentra."
msgstr "Strikes the ground and opens a crack that runs in a straight line, damaging and briefly stunning everything in its path."

#: data/weapons/martillo.tres
msgid "Martillo de geólogo"
msgstr "Geologist's hammer"

#: data/weapons/martillo_barrera.tres
msgid "Martillo de la Barrera"
msgstr "Hammer of the Barrier"

#: data/weapons/martillo_barrera.tres
msgid "Una grieta más larga y más ancha que aturde más tiempo."
msgstr "A longer, wider crack that stuns for longer."

#: data/weapons/mauser.tres
msgid "Pistola Mauser C96"
msgstr "Mauser C96 pistol"

#: data/weapons/mauser.tres
msgid "Ráfagas cortas de tres trazadoras."
msgstr "Short bursts of three tracers."

#: data/weapons/mauser_tillinghast.tres
msgid "Mauser de Tillinghast"
msgstr "Tillinghast's Mauser"

#: data/weapons/mauser_tillinghast.tres
msgid "Ráfagas más largas y más seguidas."
msgstr "Longer, more frequent bursts."

#: data/weapons/medusas_mas_alla.tres
msgid "Los revelados que mueren revientan en un picotazo violeta que daña y revela a los de alrededor; vibra más a menudo."
msgstr "The revealed who die burst in a violet sting that damages and reveals those around them; it pulses more often."

#: data/weapons/medusas_mas_alla.tres
msgid "Medusas del más allá"
msgstr "Jellyfish from beyond"

#: data/weapons/migo.tres
msgid "Orbe Mi-Go"
msgstr "Mi-Go orb"

#: data/weapons/migo.tres
msgid "Un orbe de los hongos de Yuggoth vuela solo a tu alrededor y dispara al enemigo más cercano. Cuesta cordura."
msgstr "An orb of the fungi from Yuggoth flies around you on its own and shoots the nearest enemy. Costs sanity."

#: data/weapons/mil_crias.tres
msgid "El doble de tentáculos, más grandes, que aturden más."
msgstr "Twice as many tentacles, bigger, that stun for longer."

#: data/weapons/mil_crias.tres
msgid "Las Mil Crías"
msgstr "The Thousand Young"

#: data/weapons/modelo_natural.tres
msgid "El modelo del natural"
msgstr "Pickman's model"

#: data/weapons/modelo_natural.tres
msgid "Un solo cuadro enorme que atrae desde muy lejos y suelta tres necrófagos."
msgstr "A single huge painting that lures from very far away and releases three ghouls."

#: data/weapons/molinete_alert.tres
msgid "Molinete del Alert"
msgstr "Windlass of the Alert"

#: data/weapons/molinete_alert.tres
msgid "Un ancla que gira muy deprisa y muy cerca, golpeando más a menudo."
msgstr "An anchor that swings very fast and very close, striking more often."

#: data/weapons/molotov.tres
msgid "Botella en arco que crea un charco en llamas."
msgstr "A bottle thrown in an arc that makes a pool of flames."

#: data/weapons/molotov.tres
msgid "Cóctel Molotov"
msgstr "Molotov cocktail"

#: data/weapons/mortero.tres
msgid "Mortero Stokes"
msgstr "Stokes mortar"

#: data/weapons/mortero.tres
msgid "Proyectil en arco alto al grupo más denso a distancia; explosión grande."
msgstr "A shell in a high arc at the densest group at range; a big explosion."

#: data/weapons/mortero_incendiario.tres
msgid "Mortero incendiario"
msgstr "Incendiary mortar"

#: data/weapons/mortero_incendiario.tres
msgid "Un proyectil enorme que deja el suelo ardiendo, algo menos seguido."
msgstr "A huge shell that leaves the ground burning, a little less often."

#: data/weapons/nagant.tres
msgid "Nagant de Danforth"
msgstr "Danforth's Nagant"

#: data/weapons/nagant.tres
msgid "Revólver cuya cadencia se acelera mientras tiene a quién disparar, hasta dos veces y media."
msgstr "A revolver whose rate of fire speeds up while it has someone to shoot at, up to two and a half times."

#: data/weapons/nagant_siete.tres
msgid "Nagant de siete tiros"
msgstr "Seven-shot Nagant"

#: data/weapons/nagant_siete.tres
msgid "Siempre a toda cadencia desde el primer disparo, y atraviesa."
msgstr "Always at full rate from the first shot, and it pierces."

#: data/weapons/nagant_vigia.tres
msgid "Nagant del vigía"
msgstr "Lookout's Nagant"

#: data/weapons/nagant_vigia.tres
msgid "Su cadencia llega a cuatro veces la inicial y acelera antes."
msgstr "Its rate of fire reaches four times the initial one and speeds up sooner."

#: data/weapons/necronomicon.tres
msgid "Necronomicón"
msgstr "Necronomicon"

#: data/weapons/necronomicon.tres
msgid "Páginas que orbitan alrededor del personaje. Cuesta cordura."
msgstr "Pages that orbit around the character. Costs sanity."

#: data/weapons/necronomicon_completo.tres
msgid "El doble de páginas girando en un círculo mayor."
msgstr "Twice as many pages spinning in a bigger circle."

#: data/weapons/necronomicon_completo.tres
msgid "Necronomicón completo"
msgstr "Complete Necronomicon"

#: data/weapons/nido_ametralladoras.tres
msgid "Nido de ametralladoras"
msgstr "Machine-gun nest"

#: data/weapons/nido_ametralladoras.tres
msgid "Torretas que duran el doble y disparan más rápido."
msgstr "Turrets that last twice as long and fire faster."

#: data/weapons/ojo_eter.tres
msgid "Ojo del Éter"
msgstr "Aether eye"

#: data/weapons/ojo_eter.tres
msgid "Un rayo más largo cuyo daño crece más deprisa y hasta más arriba."
msgstr "A longer beam whose damage grows faster and higher."

#: data/weapons/ojos_de_ephraim.tres
msgid "Cinco miradas de Asenath, que llegan más lejos y buscan con más ganas."
msgstr "Five of Asenath's glares, which reach further and seek more eagerly."

#: data/weapons/ojos_de_ephraim.tres
msgid "Los ojos de Ephraim"
msgstr "The eyes of Ephraim"

#: data/weapons/ooth_nargai.tres
msgid "Donde el tiempo no pasa: los que se quedan dentro se duermen un momento; sueños más amplios."
msgstr "Where time does not pass: those who stay inside fall asleep for a moment; wider dreams."

#: data/weapons/ooth_nargai.tres
msgid "Valle de Ooth-Nargai"
msgstr "Valley of Ooth-Nargai"

#: data/weapons/palanca.tres
msgid "Disparos rápidos que atraviesan a varios enemigos."
msgstr "Fast shots that pierce several enemies."

#: data/weapons/palanca.tres
msgid "Rifle de palanca"
msgstr "Lever-action rifle"

#: data/weapons/piolet_pabodie.tres
msgid "Grietas más cortas y rapidísimas, el doble de seguidas."
msgstr "Shorter, very fast cracks, twice as often."

#: data/weapons/piolet_pabodie.tres
msgid "Piolet de Pabodie"
msgstr "Pabodie's ice axe"

#: data/weapons/polvo.tres
msgid "Esparce una nube sobre el grupo más denso: dentro, los enemigos van un 40 % más lentos y hacen un 30 % menos de daño. Cuesta cordura."
msgstr "Spreads a cloud over the densest group: inside, enemies move 40 % slower and deal 30 % less damage. Costs sanity."

#: data/weapons/polvo.tres
msgid "Polvo de Ibn-Ghazi"
msgstr "Powder of Ibn-Ghazi"

#: data/weapons/polvo_antiguos.tres
msgid "Polvo de los Antiguos"
msgstr "Powder of the Elder Things"

#: data/weapons/polvo_antiguos.tres
msgid "Una nube mucho mayor que frena y debilita más."
msgstr "A much bigger cloud that slows and weakens more."

#: data/weapons/polvo_schacabao.tres
msgid "Polvo de Ibn Schacabao"
msgstr "Powder of Ibn Schacabao"

#: data/weapons/polvo_schacabao.tres
msgid "Una nube que apenas frena, pero deja vulnerables a los que la respiran y hace más daño."
msgstr "A cloud that barely slows, but leaves those who breathe it vulnerable and deals more damage."

#: data/weapons/prisma_eter.tres
msgid "Prisma del Éter"
msgstr "Aether prism"

#: data/weapons/prisma_eter.tres
msgid "Un rayo sin espera: hace todo su daño desde el primer instante y vuelve antes."
msgstr "A beam with no wind-up: it deals all its damage from the first instant and comes back sooner."

#: data/weapons/puerta_yog.tres
msgid "La Puerta y la Llave"
msgstr "The Gate and the Key"

#: data/weapons/puerta_yog.tres
msgid "Una esfera mayor que atrae con mucha más fuerza y dura más."
msgstr "A bigger sphere that pulls much harder and lasts longer."

#: data/weapons/puestos_tiro.tres
msgid "Puestos de tiro"
msgstr "Firing posts"

#: data/weapons/puestos_tiro.tres
msgid "Torretas mucho más a menudo y de más alcance, que duran menos."
msgstr "Turrets much more often and with longer range, but they last less."

#: data/weapons/racimo_granadas.tres
msgid "Cinco granadas pequeñas repartidas por el grupo, más a menudo."
msgstr "Five small grenades spread over the group, more often."

#: data/weapons/racimo_granadas.tres
msgid "Racimo de granadas"
msgstr "Grenade cluster"

#: data/weapons/rayo_gran_raza.tres
msgid "Rayo de la Gran Raza"
msgstr "Ray of the Great Race"

#: data/weapons/rayo_gran_raza.tres
msgid "Una estasis más larga y el rayo atraviesa a tres enemigos."
msgstr "A longer stasis, and the ray pierces three enemies."

#: data/weapons/rayo_pnakotus.tres
msgid "Dos rayos, más del doble de seguidos, con una estasis más corta."
msgstr "Two rays, more than twice as often, with a shorter stasis."

#: data/weapons/rayo_pnakotus.tres
msgid "Rayo de Pnakotus"
msgstr "Ray of Pnakotus"

#: data/weapons/rayo_wardenclyffe.tres
msgid "Rayo de Wardenclyffe"
msgstr "Wardenclyffe bolt"

#: data/weapons/rayo_wardenclyffe.tres
msgid "Salta a la mitad de enemigos, pero los deja aturdidos casi un segundo."
msgstr "It jumps to half as many enemies, but leaves them stunned for almost a second."

#: data/weapons/reactivo_perfecto.tres
msgid "El suero atraviesa y los inyectados se levantan el doble de tiempo."
msgstr "The serum pierces and the injected rise for twice as long."

#: data/weapons/reactivo_perfecto.tres
msgid "Reactivo perfeccionado"
msgstr "Perfected reagent"

#: data/weapons/recortada.tres
msgid "Dos disparos seguidos de perdigones en un cono corto y ancho que empuja mucho."
msgstr "Two shots in a row of pellets in a short, wide cone that pushes hard."

#: data/weapons/recortada.tres
msgid "Recortada"
msgstr "Sawn-off shotgun"

#: data/weapons/recortada_contrabandista.tres
msgid "Recortada del contrabandista"
msgstr "Smuggler's sawn-off"

#: data/weapons/recortada_contrabandista.tres
msgid "Tres disparos seguidos con más perdigones y más empuje."
msgstr "Three shots in a row with more pellets and more knockback."

#: data/weapons/recortada_matadero.tres
msgid "Recortada del matadero"
msgstr "Slaughterhouse sawn-off"

#: data/weapons/recortada_matadero.tres
msgid "Un solo disparo de tres balas gruesas que atraviesan y lanzan lejos."
msgstr "A single shot of three heavy slugs that pierce and hurl enemies far."

#: data/weapons/red.tres
msgid "Lanza una red sobre el grupo más denso: los de debajo se quedan inmóviles 2 segundos. Las élites solo se frenan."
msgstr "Throws a net over the densest group: those underneath are held still for 2 seconds. Elites are only slowed."

#: data/weapons/red.tres
msgid "Red de pesca"
msgstr "Fishing net"

#: data/weapons/red_innsmouth.tres
msgid "Red de Innsmouth"
msgstr "Innsmouth net"

#: data/weapons/red_innsmouth.tres
msgid "Una red más grande que inmoviliza el doble de tiempo."
msgstr "A bigger net that holds for twice as long."

#: data/weapons/redes_arrastre.tres
msgid "Redes de arrastre"
msgstr "Trawl nets"

#: data/weapons/redes_arrastre.tres
msgid "Tres redes más pequeñas a la vez."
msgstr "Three smaller nets at once."

#: data/weapons/resonador.tres
msgid "Resonador"
msgstr "Resonator"

#: data/weapons/resonador.tres
msgid "Vibra cada poco y su pulso deshace las balas enemigas cercanas; hace poco daño. Solo vibra si hay balas o enemigos cerca. Cuesta cordura."
msgstr "It hums every so often and its pulse dissolves nearby enemy bullets; it deals little damage. It only hums if bullets or enemies are close. Costs sanity."

#: data/weapons/resonador_crawford.tres
msgid "Resonador de Crawford"
msgstr "Crawford's resonator"

#: data/weapons/resonador_crawford.tres
msgid "Una onda que golpea más fuerte y lanza el triple de lejos lo que alcanza, algo menos seguida."
msgstr "A wave that hits harder and hurls what it reaches three times as far, a little less often."

#: data/weapons/revolver_vigia.tres
msgid "Dos disparos pesados seguidos que atraviesan a tres enemigos y los echan atrás."
msgstr "Two heavy shots in a row that pierce three enemies and knock them back."

#: data/weapons/revolver_vigia.tres
msgid "Revólver del vigía"
msgstr "Lookout's revolver"

#: data/weapons/rey_amarillo.tres
msgid "El Rey de Amarillo"
msgstr "The King in Yellow"

#: data/weapons/rey_amarillo.tres
msgid "Enloquece al doble de enemigos durante más tiempo."
msgstr "Drives twice as many enemies mad, for longer."

#: data/weapons/rifle_caza_mayor.tres
msgid "Rifle de caza mayor"
msgstr "Big-game rifle"

#: data/weapons/rifle_caza_mayor.tres
msgid "Un disparo pesado que deja clavados y echa atrás a los que atraviesa."
msgstr "A heavy shot that pins and knocks back those it pierces."

#: data/weapons/rifle_miskatonic.tres
msgid "Dos disparos rápidos que atraviesan a seis enemigos; uno de cada cinco es crítico (doble daño)."
msgstr "Two fast shots that pierce six enemies; one in five is a critical hit (double damage)."

#: data/weapons/rifle_miskatonic.tres
msgid "Rifle Miskatonic"
msgstr "Miskatonic rifle"

#: data/weapons/sable_husar.tres
msgid "Sable del húsar"
msgstr "Hussar's sabre"

#: data/weapons/sable_husar.tres
msgid "Una estocada ancha y pesada que echa atrás a toda la línea."
msgstr "A wide, heavy thrust that knocks back the whole line."

#: data/weapons/sales_esenciales.tres
msgid "Esparce las sales donde más enemigos han caído y recita la fórmula: daña a los de alrededor y levanta a dos de los caídos, que luchan por él un rato. Cuesta cordura."
msgstr "Scatters the salts where most enemies have fallen and recites the formula: it damages those around and raises two of the fallen, who fight for him for a while. Costs sanity."

#: data/weapons/sales_esenciales.tres
msgid "Sales esenciales"
msgstr "Essential salts"

#: data/weapons/serannian.tres
msgid "Serannian"
msgstr "Serannian"

#: data/weapons/serannian.tres
msgid "Un solo sueño, más amplio y largo, que viaja con Kuranes como la ciudad de nubes rosadas por el cielo; dentro se descansa más."
msgstr "A single dream, wider and longer, that travels with Kuranes like the city of pink clouds across the sky; inside, you rest more."

#: data/weapons/shub.tres
msgid "Tentáculos de Shub"
msgstr "Tentacles of Shub"

#: data/weapons/shub.tres
msgid "Tentáculos que brotan del suelo, tras un aviso, bajo enemigos al azar."
msgstr "Tentacles that burst from the ground, after a warning, beneath random enemies."

#: data/weapons/signo.tres
msgid "Signo Arcano"
msgstr "Arcane Sign"

#: data/weapons/signo.tres
msgid "Traza bajo sus pies un signo que daña y empuja hacia fuera a los enemigos; las balas enemigas que lo cruzan van a la mitad de velocidad. Cuesta cordura."
msgstr "Draws a sign beneath their feet that damages enemies and pushes them outwards; enemy bullets crossing it move at half speed. Costs sanity."

#: data/weapons/signo_amarillo.tres
msgid "Los enemigos que lo miran enloquecen y atacan a los suyos unos segundos."
msgstr "Enemies who look at it go mad and attack their own for a few seconds."

#: data/weapons/signo_amarillo.tres
msgid "Signo Amarillo"
msgstr "Yellow Sign"

#: data/weapons/signo_koth.tres
msgid "Signo de Koth"
msgstr "Sign of Koth"

#: data/weapons/signo_koth.tres
msgid "Un signo algo menor y mucho más seguido que empuja con fuerza hacia fuera."
msgstr "A slightly smaller sign, much more often, that pushes hard outwards."

#: data/weapons/signo_mayor.tres scripts/core/game.gd
msgid "Signo Mayor"
msgstr "Elder Sign"

#: data/weapons/signo_mayor.tres
msgid "Un signo mucho mayor que frena aún más las balas enemigas."
msgstr "A much bigger sign that slows enemy bullets even more."

#: data/weapons/springfield.tres
msgid "Disparo lento y fuerte que busca primero a la élite o al enemigo con más vida; a veces es un crítico triple. Atraviesa a uno."
msgstr "A slow, powerful shot that targets the elite or the enemy with the most health first; sometimes it is a triple critical hit. Pierces one."

#: data/weapons/springfield.tres
msgid "Springfield M1903"
msgstr "Springfield M1903"

#: data/weapons/springfield_belleau.tres
msgid "Dispara más del doble de seguido y atraviesa a uno más; menos críticos."
msgstr "Fires more than twice as often and pierces one more; fewer critical hits."

#: data/weapons/springfield_belleau.tres
msgid "Springfield de Belleau"
msgstr "Belleau Springfield"

#: data/weapons/springfield_francotirador.tres
msgid "Críticos más probables y de cuádruple daño que atraviesan a tres enemigos."
msgstr "More likely critical hits, dealing four times the damage and piercing three enemies."

#: data/weapons/springfield_francotirador.tres
msgid "Springfield del francotirador"
msgstr "Sniper's Springfield"

#: data/weapons/suero_halsey.tres
msgid "Suero de Halsey"
msgstr "Halsey's serum"

#: data/weapons/suero_halsey.tres
msgid "Tres dardos por disparo: más resucitados, que duran menos."
msgstr "Three darts per shot: more reanimated, but they last less."

#: data/weapons/tesla.tres
msgid "Bobina Tesla"
msgstr "Tesla coil"

#: data/weapons/tesla.tres
msgid "Descarga un rayo al enemigo más cercano que salta a los siguientes, hasta cuatro; cada salto hace un poco menos."
msgstr "Discharges a bolt at the nearest enemy that jumps to the next ones, up to four; each jump deals a little less."

#: data/weapons/thompson.tres
msgid "Ráfagas cerradas de proyectiles pequeños."
msgstr "Tight bursts of small projectiles."

#: data/weapons/thompson.tres
msgid "Thompson M1928"
msgstr "Thompson M1928"

#: data/weapons/thompson_chicago.tres
msgid "Tambor de cien balas: muchas más por ráfaga."
msgstr "A hundred-round drum: many more per burst."

#: data/weapons/thompson_chicago.tres
msgid "Thompson de Chicago"
msgstr "Chicago Thompson"

#: data/weapons/thompson_federal.tres
msgid "Ráfagas cortas y precisas, el doble de seguidas, que atraviesan a dos."
msgstr "Short, precise bursts, twice as often, that pierce two."

#: data/weapons/thompson_federal.tres
msgid "Thompson del agente federal"
msgstr "Federal agent's Thompson"

#: data/weapons/trapezoedro.tres
msgid "Rayo de luz concentrada que daña todo lo que atraviesa. Cuesta cordura."
msgstr "A ray of concentrated light that damages everything it passes through. Costs sanity."

#: data/weapons/trapezoedro.tres
msgid "Trapezoedro"
msgstr "Trapezohedron"

#: data/weapons/trapezoedro_blake.tres
msgid "Trapezoedro de Blake"
msgstr "Blake's Trapezohedron"

#: data/weapons/trapezoedro_blake.tres
msgid "Un rayo más fino, el doble de seguido."
msgstr "A thinner ray, twice as often."

#: data/weapons/trapezoedro_despierto.tres
msgid "Trapezoedro despierto"
msgstr "Awakened Trapezohedron"

#: data/weapons/trapezoedro_despierto.tres
msgid "Un rayo más largo y el doble de ancho."
msgstr "A longer ray, twice as wide."

#: data/weapons/trono_azathoth.tres
msgid "Al apagarse o en el último choque, cada ángulo se abre en cuatro esquirlas que también doblan esquinas."
msgstr "When it fades or on its last hit, each angle splits into four shards that also turn corners."

#: data/weapons/trono_azathoth.tres
msgid "El trono de Azathoth"
msgstr "The throne of Azathoth"

#: data/weapons/umr_tawil.tres
msgid "Esferas más pequeñas y rápidas, el doble de seguidas."
msgstr "Smaller, faster spheres, twice as often."

#: data/weapons/umr_tawil.tres
msgid "Umr at-Tawil"
msgstr "Umr at-Tawil"

#: data/weapons/viento_ithaqua.tres
msgid "El que camina con el viento"
msgstr "The one who walks on the wind"

#: data/weapons/viento_ithaqua.tres
msgid "Un aliento helado estrecho que llega muy lejos."
msgstr "A narrow icy breath that reaches very far."

#: data/weapons/webly.tres
msgid "Proyectiles pesados que hacen retroceder a los enemigos."
msgstr "Heavy projectiles that knock enemies back."

#: data/weapons/webly.tres
msgid "Webly Mk VI"
msgstr "Webley Mk VI"

#: data/weapons/webly_seis_tiros.tres
msgid "Vacía el tambor: seis balas en abanico de una vez."
msgstr "Empties the cylinder: six bullets in a fan at once."

#: data/weapons/webly_seis_tiros.tres
msgid "Webly de seis tiros"
msgstr "Six-shot Webley"

#: data/weapons/wendigo.tres
msgid "Aliento del Wendigo"
msgstr "Breath of the Wendigo"

#: data/weapons/wendigo.tres
msgid "Un viento helado más largo y ancho que congela antes."
msgstr "A longer, wider icy wind that freezes sooner."

#: data/weapons/west.tres
msgid "Dispara dardos de suero: el enemigo que muere con el suero dentro se levanta 6 segundos como aliado y ataca a los suyos."
msgstr "Fires serum darts: an enemy that dies with the serum inside rises for 6 seconds as an ally and attacks its own."

#: data/weapons/west.tres
msgid "Inyector de West"
msgstr "West's injector"

#: data/weapons/yith.tres
msgid "Congela al enemigo en el tiempo 1,5 s; el daño que recibe mientras tanto se aplica al final, un 50 % mayor. Cuesta cordura."
msgstr "Freezes the enemy in time for 1.5 s; the damage it takes meanwhile is applied at the end, 50 % greater. Costs sanity."

#: data/weapons/yith.tres
msgid "Rayo de Yith"
msgstr "Ray of Yith"

#: data/weapons/yog.tres
msgid "Esfera de Yog-Sothoth"
msgstr "Sphere of Yog-Sothoth"

#: data/weapons/yog.tres
msgid "Orbe lento que atrae a los enemigos hacia su centro y los tritura."
msgstr "A slow orb that pulls enemies into its centre and grinds them up."

#: data/weather/bruma_gruta.tres
msgid "Bruma de la gruta"
msgstr "Grotto mist"

#: data/weather/bruma_paso.tres
msgid "Bruma del paso"
msgstr "Mist of the pass"

#: data/weather/ceniza.tres
msgid "Lluvia de ceniza"
msgstr "Ash fall"

#: data/weather/ceniza_gris.tres
msgid "Ceniza gris de la granja"
msgstr "Grey ash of the farm"

#: data/weather/lluvia.tres
msgid "Lluvia"
msgstr "Rain"

#: data/weather/lluvia_ligera.tres
msgid "Lluvia ligera"
msgstr "Light rain"

#: data/weather/nevada.tres scripts/level/weather_data.gd
msgid "Nevada"
msgstr "Snowfall"

#: data/weather/nevada_kadath.tres
msgid "Nevada de Kadath"
msgstr "Snowfall of Kadath"

#: data/weather/niebla.tres
msgid "Niebla densa"
msgstr "Dense fog"

#: data/weather/niebla_arrecife.tres
msgid "Niebla del Arrecife"
msgstr "Reef fog"

#: data/weather/niebla_marina.tres
msgid "Niebla marina"
msgstr "Sea fog"

#: data/weather/niebla_marina_noche.tres
msgid "Niebla marina de noche"
msgstr "Night sea fog"

#: data/weather/niebla_pantano.tres
msgid "Niebla del pantano"
msgstr "Swamp fog"

#: data/weather/tormenta.tres
msgid "Tormenta"
msgstr "Storm"

#: data/weather/tormenta_dunwich.tres
msgid "Tormenta sobre Sentinel Hill"
msgstr "Storm over Sentinel Hill"

#: data/weather/ventisca_ligera.tres
msgid "Ventisca ligera"
msgstr "Light blizzard"

